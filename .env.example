# Copy this file to .env and fill in real values before deploying anywhere
# beyond your own machine. Never commit .env.

# Required for production: signs session cookies. Without this, a random key
# is generated each time the process starts, which invalidates existing
# sessions on every restart and won't work correctly across multiple worker
# processes. Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# development | production - controls whether the session cookie requires HTTPS
FLASK_ENV=development

# Comma-separated list of origins allowed to make credentialed requests to the API.
# Only relevant if the frontend is served from a different origin than the API
# (unusual for this app, since Flask serves both from the same origin by default).
ALLOWED_ORIGINS=http://localhost:5000

# Bootstrap admin account, created automatically on first run if no admin exists yet.
# If INITIAL_ADMIN_PASSWORD is left blank, a random password is generated and
# printed once to the console/log - copy it from there instead of guessing it.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Set to true to enable Flask's debug mode (auto-reload + interactive debugger).
# Never enable this in a real deployment - the interactive debugger allows
# arbitrary code execution if reachable by anyone other than you.
FLASK_DEBUG=false
